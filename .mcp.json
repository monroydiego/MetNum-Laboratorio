{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {}
    },
    "sqlite-auditoria": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp>=1.6,<2",
        "mcp-server-sqlite",
        "--db-path",
        "./backend/data/auditoria_docente.db"
      ],
      "env": {}
    }
  }
}